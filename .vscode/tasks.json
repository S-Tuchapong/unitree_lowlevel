{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "G1BeamVariant",
      "type": "pickString",
      "description": "G1 depth policy variant",
      "options": ["V1", "V2", "V3", "V4"],
      "default": "V2"
    },
{
  "id": "G1TrainingTerrain",
  "type": "pickString",
  "description": "Training terrain level (half levels are midpoint widths): 0 = 0.60 m wide, 9 = 0.18 m wide; custom = 0.20 m wide; height above ground = 0.55 m",
  "options": [
    "scene_depth_training_level_0.xml",
    "scene_depth_training_level_0p5.xml",
    "scene_depth_training_level_1.xml",
    "scene_depth_training_level_1p5.xml",
    "scene_depth_training_level_2.xml",
    "scene_depth_training_level_2p5.xml",
    "scene_depth_training_level_3.xml",
    "scene_depth_training_level_3p5.xml",
    "scene_depth_training_level_4.xml",
    "scene_depth_training_level_4p5.xml",
    "scene_depth_training_level_5.xml",
    "scene_depth_training_level_5p5.xml",
    "scene_depth_training_level_6.xml",
    "scene_depth_training_level_6p5.xml",
    "scene_depth_training_level_7.xml",
    "scene_depth_training_level_7p5.xml",
    "scene_depth_training_level_8.xml",
    "scene_depth_training_level_8p5.xml",
    "scene_depth_training_level_9.xml",
    "scene_depth_training_width_20cm.xml"
  ],
  "default": "scene_depth_training_level_0.xml"
},
    {
      "id": "G1BeamRosDistro",
      "type": "pickString",
      "description": "G1 beam ROS distribution",
      "options": [
        "humble",
        "jazzy",
        "foxy",
        "galactic"
      ],
      "default": "humble"
    },
    {
      "id": "G1BeamNetworkInterface",
      "type": "promptString",
      "description": "G1 beam robot network interface (lo for local simulation)",
      "default": "eth0"
    },
    {
      "id": "RosDistro",
      "type": "pickString",
      "description": "Select ROS distribution",
      "options": ["jazzy", "humble", "foxy", "galactic"],
      "default": "humble"
    },
    {
      "id": "BuildType",
      "type": "pickString",
      "description": "Select build type",
      "options": ["Debug", "Release"],
      "default": "Release"
    },
    {
      "id": "NetworkInterface",
      "type": "pickString",
      "description": "Select network interface",
      "options": ["lo", "eth0", "enp130s0", "wlp129s0f0"],
      "default": "lo"
    },
    // Visualization
    {
      "id": "Display",
      "type": "pickString",
      "description": "Select display",
      "options": ["0", "1", "1001"],
      "default": "0"
    },
    // Unitree Mujoco
    {
      "id": "Robot",
      "type": "pickString",
      "description": "Select robot",
      "options": ["go2", "g1"],
      "default": "go2"
    },
    {
      "id": "Scene",
      "type": "promptString",
      "description": "Input scene",
      "default": "scene.xml"
    },
    {
      "id": "G1FlatScene",
      "type": "pickString",
      "description": "Select G1 scene XML",
      "options": [
        "scene_29dof.xml",
        "scene_bridge.xml"
      ],
      "default": "scene_29dof.xml"
    },
  ],
  "tasks": [
{
  "label": "G1 Beam Sim: Training Terrain",
  "type": "process",
  "command": "bash",
  "args": [
    "${workspaceFolder}/../legged_rl_deploy/scripts/run.sh",
    "lo",
    "${input:G1BeamRosDistro}",
    "ros2",
    "run",
    "unitree_mujoco",
    "unitree_mujoco",
    "--config",
    "${workspaceFolder}/../legged_rl_deploy/policies/g1/beam/g1_beam_depth_distillation/mujoco_training.yaml",
    "--scene",
    "${input:G1TrainingTerrain}",
    "--depth-camera"
  ],
  "options": {
    "cwd": "${workspaceFolder}/../legged_rl_deploy"
  },
  "presentation": {
    "reveal": "always",
    "panel": "dedicated"
  },
  "problemMatcher": []
},
{
  "label": "G1 Beam Sim: Training Terrain + Depth",
  "dependsOrder": "parallel",
  "dependsOn": [
    "G1 Beam Sim: Training Terrain",
    "G1 Beam Sim: Depth"
  ],
  "problemMatcher": []
},
{
  "label": "G1 Beam Sim: Mujoco",
  "type": "process",
  "command": "bash",
  "args": [
    "${workspaceFolder}/../legged_rl_deploy/scripts/run.sh",
    "lo",
    "${input:G1BeamRosDistro}",
    "ros2",
    "run",
    "unitree_mujoco",
    "unitree_mujoco",
    "--config",
    "${workspaceFolder}/../legged_rl_deploy/policies/g1/beam/g1_beam_depth_distillation/mujoco.yaml",
    "--depth-camera"
  ],
  "options": {
    "cwd": "${workspaceFolder}/../legged_rl_deploy"
  },
  "presentation": {
    "reveal": "always",
    "panel": "dedicated"
  },
  "problemMatcher": []
},
{
  "label": "G1 Beam Sim: Depth",
  "type": "process",
  "command": "bash",
  "args": [
    "${workspaceFolder}/../legged_rl_deploy/scripts/run.sh",
    "lo",
    "${input:G1BeamRosDistro}",
    "ros2",
    "run",
    "legged_rl_deploy",
    "depth_image_preprocessor_node.py",
    "--ros-args",
    "--params-file",
    "${workspaceFolder}/../legged_rl_deploy/policies/g1/beam/g1_beam_depth_distillation/depth_image_preprocessor_variants_sim.yaml"
  ],
  "options": {
    "cwd": "${workspaceFolder}/../legged_rl_deploy"
  },
  "presentation": {
    "reveal": "always",
    "panel": "dedicated"
  },
  "problemMatcher": []
},
{
  "label": "G1 Beam Sim: Mujoco + Depth",
  "dependsOrder": "parallel",
  "dependsOn": [
    "G1 Beam Sim: Mujoco",
    "G1 Beam Sim: Depth"
  ],
  "problemMatcher": []
},
{
  "label": "G1 Beam Sim: Policy",
  "type": "process",
  "command": "bash",
  "args": [
    "${workspaceFolder}/../legged_rl_deploy/scripts/run.sh",
    "lo",
    "${input:G1BeamRosDistro}",
    "ros2",
    "run",
    "legged_rl_deploy",
    "legged_rl_deploy_node",
    "lo",
    "${workspaceFolder}/../legged_rl_deploy/policies/g1/beam/g1_beam_depth_distillation/${input:G1BeamVariant}/config_sim.yaml"
  ],
  "options": {
    "cwd": "${workspaceFolder}/../legged_rl_deploy"
  },
  "presentation": {
    "reveal": "always",
    "panel": "dedicated"
  },
  "problemMatcher": []
},
{
  "label": "G1 Beam Sim: Check Depth Rate",
  "type": "process",
  "command": "bash",
  "args": [
    "${workspaceFolder}/../legged_rl_deploy/scripts/run.sh",
    "lo",
    "${input:G1BeamRosDistro}",
    "ros2",
    "topic",
    "hz",
    "/g1_sim/beam_depth/normalized"
  ],
  "options": {
    "cwd": "${workspaceFolder}/../legged_rl_deploy"
  },
  "presentation": {
    "reveal": "always",
    "panel": "dedicated"
  },
  "problemMatcher": []
},
    {
      "label": "G1 Beam: Camera",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/../legged_rl_deploy/scripts/run.sh",
        "${input:G1BeamNetworkInterface}",
        "${input:G1BeamRosDistro}",
        "ros2",
        "launch",
        "realsense2_camera",
        "rs_launch.py",
        "config_file:='${workspaceFolder}/../legged_rl_deploy/policies/g1/beam/g1_beam_depth_distillation/D435i.yaml'"
      ],
      "options": {
        "cwd": "${workspaceFolder}/../legged_rl_deploy"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "G1 Beam: Depth Preprocessor",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/../legged_rl_deploy/scripts/run.sh",
        "${input:G1BeamNetworkInterface}",
        "${input:G1BeamRosDistro}",
        "ros2",
        "run",
        "legged_rl_deploy",
        "depth_image_preprocessor_node.py",
        "--ros-args",
        "--params-file",
        "${workspaceFolder}/../legged_rl_deploy/policies/g1/beam/g1_beam_depth_distillation/depth_image_preprocessor.yaml"
      ],
      "options": {
        "cwd": "${workspaceFolder}/../legged_rl_deploy"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "G1 Beam: Camera + Depth",
      "dependsOrder": "parallel",
      "dependsOn": [
        "G1 Beam: Camera",
        "G1 Beam: Depth Preprocessor"
      ],
      "problemMatcher": []
    },
    {
      "label": "G1 Beam: Policy",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/../legged_rl_deploy/scripts/run.sh",
        "${input:G1BeamNetworkInterface}",
        "${input:G1BeamRosDistro}",
        "ros2",
        "run",
        "legged_rl_deploy",
        "legged_rl_deploy_node",
        "${input:G1BeamNetworkInterface}",
        "${workspaceFolder}/../legged_rl_deploy/policies/g1/beam/g1_beam_depth_distillation/config.yaml"
      ],
      "options": {
        "cwd": "${workspaceFolder}/../legged_rl_deploy"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "G1 Beam: Check Depth Rate",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/../legged_rl_deploy/scripts/run.sh",
        "${input:G1BeamNetworkInterface}",
        "${input:G1BeamRosDistro}",
        "ros2",
        "topic",
        "hz",
        "/unitree_g1_beam_depth/depth_m"
      ],
      "options": {
        "cwd": "${workspaceFolder}/../legged_rl_deploy"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/colcon-config.sh ${input:RosDistro} ${input:BuildType}",
      "group": "build",
      "problemMatcher": []
    },

    // PlotJuggler
    {
      "label": "ROS2: PlotJuggler",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/ros2_task.sh",
        "${input:NetworkInterface}", "${input:RosDistro}",
        "ros2", "run", "plotjuggler", "plotjuggler",
        "--", "-l", "${workspaceFolder}/../../src/legged_base/plot/legged_state.xml"
      ],
      "options": {
        "env": { "DISPLAY": ":${input:Display}" }
      },
      "problemMatcher": []
    },
    {
      "label": "ROS2: Mujoco",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/ros2_task.sh", "lo", "${input:RosDistro}",
        "ros2", "run", "unitree_mujoco", "unitree_mujoco",
        "-r", "${input:Robot}", "-s", "${input:G1FlatScene}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ROS2: Mujoco G1 Flat (Upper Body Locked)",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/ros2_task.sh", "lo", "${input:RosDistro}",
        "ros2", "run", "unitree_mujoco", "unitree_mujoco",
        "-r", "g1", "-s", "${input:G1FlatScene}",
        "--debug-fix-upper-body"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Unitree: Go2 Test",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/ros2_task.sh",
        "${input:NetworkInterface}", "${input:RosDistro}",
        "../../build/unitree_sdk2/bin/go2_stand_example", "${input:NetworkInterface}"
      ],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Unitree: G1 Test",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/ros2_task.sh",
        "${input:NetworkInterface}", "${input:RosDistro}",
        "../../build/unitree_sdk2/bin/g1_ankle_swing_example", "${input:NetworkInterface}"
      ],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },

    // Controller
    {
      "label": "ROS2: LowLevel",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/ros2_task.sh",
        "${input:NetworkInterface}", "${input:RosDistro}",
        "ros2", "run", "unitree_lowlevel", "go2_lowlevel_node",
        "${input:NetworkInterface}",
        "../../src/unitree_lowlevel/config/${input:Robot}.yaml"
      ],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
  ]
}
